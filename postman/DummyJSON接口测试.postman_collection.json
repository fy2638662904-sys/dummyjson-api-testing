    {
      "name": "用户接口",
      "item": [
        {
          "name": "API-011 获取当前用户",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"状态码为 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"响应为 JSON\", function () { pm.response.to.be.json; });",
                  "const json = pm.response.json();",
                  "pm.test(\"返回 id 字段\", function () { pm.expect(json).to.have.property(\"id\"); });",
                  "pm.test(\"返回 username 字段\", function () { pm.expect(json).to.have.property(\"username\"); });",
                  "pm.test(\"username 与登录用户一致\", function () { pm.expect(json.username).to.eql(pm.environment.get(\"username\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "使用 API-001 写入的 token 获取当前用户信息，依赖执行顺序。"
          }
        },
        {
          "name": "API-012 获取用户列表",
          "event": [
