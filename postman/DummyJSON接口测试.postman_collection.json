                  "const json = pm.response.json();",
                  "pm.test(\"返回 message 字段\", function () { pm.expect(json).to.have.property(\"message\"); });",
                  "pm.test(\"错误信息为 Invalid credentials\", function () { pm.expect(json.message).to.eql(\"Invalid credentials\"); });"
