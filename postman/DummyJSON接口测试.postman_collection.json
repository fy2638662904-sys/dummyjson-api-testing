                  "pm.test(\"响应为 JSON\", function () { pm.response.to.be.json; });",
                  "const json = pm.response.json();",
                  "pm.test(\"返回 users 字段\", function () { pm.expect(json).to.have.property(\"users\"); });",
                  "pm.test(\"users 为非空数组\", function () { pm.expect(json.users).to.be.an(\"array\").and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
